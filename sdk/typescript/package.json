{
  "name": "galleton",
  "version": "0.1.0",
  "description": "Server-side TypeScript and JavaScript client for the local Galleton session daemon",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microck/galleton.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/Microck/galleton#readme",
  "bugs": {
    "url": "https://github.com/Microck/galleton/issues"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
